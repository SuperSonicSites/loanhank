{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loanhank-decoder",
  "main": "src/api/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // loanhank.com is still served by the ancestor Worker. This one stays on
  // workers.dev until the decoder is the product; the cutover is a routes
  // block added here in the same commit that retires the old Worker.
  "workers_dev": true,

  // Self-hosted font subsets only (design.md section 4 allows no third-party
  // font host). Nothing in public/ answers "/", so the page still comes from
  // the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loanhank",
      "database_id": "b1a81db8-b810-4c52-9b3e-091bfb1c1e83",
      "migrations_dir": "migrations"
    }
  ],

  // QUOTES is deliberately empty. The happy path never writes a photo: the
  // bytes go from the request straight to the reader and are gone when the
  // answer comes back, so there is nothing to store and nothing to delete.
  // The bucket and its one-day expiry rule stay as a backstop against any
  // future path that does write one. Its rule must never be anywhere near the
  // backups, which are the company.
  "r2_buckets": [
    { "binding": "QUOTES", "bucket_name": "loanhank-quotes" },
    { "binding": "BACKUPS", "bucket_name": "loanhank-backups" }
  ],

  // Per-IP rate limit (spec.md Decision 7). Every decode writes a row into the
  // pile and every extract will cost real model money, so both are metered.
  // Twenty a minute is generous for a farmer trying variations on his quote
  // and useless to a script.
  "ratelimits": [
    {
      "name": "DECODE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  // Retention reaper every 15 minutes; D1 export to R2 nightly at 07:00 UTC.
  "triggers": {
    "crons": ["*/15 * * * *", "0 7 * * *"]
  },

  "observability": { "enabled": true },

  // Non-secret configuration only. Every credential is a Worker secret set with
  // `wrangler secret put` — see .dev.vars.example for the full list.
  "vars": {
    "PRIMARY_EXTRACTION_MODEL": "gpt-5.6-terra",
    "FALLBACK_EXTRACTION_MODEL": "gpt-5.6-sol",
    "EXTRACTION_TIMEOUT_MS": "75000",
    "OPENAI_DATA_CONTROLS_VERIFIED": "false",
    "RAW_FILE_TTL_SECONDS": "3600",
    // Turnstile site key is public by design; TURNSTILE_SECRET_KEY is a secret.
    // Empty = upload protection off.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEQrCZAfzTs3XiRr",
    // Sender for the teardown. The domain is verified at Resend and DMARC is
    // inherited from loanhank.com at p=none.
    "EMAIL_FROM": "hank@mail.loanhank.com",
    // CAN-SPAM requires a real postal address in every commercial email.
    // Printed verbatim in every email footer, in the teardown PDF, and on
    // /contact, so the code never prefixes or reformats it.
    //
    // This is a var, not a secret. It is public by definition, it is the thing
    // that keeps every send lawful, and a value like that belongs in review and
    // in git rather than in a store nobody reads. Same reasoning as the R2
    // lifecycle rules: unversioned infra that enforces a promise is a promise
    // that can silently stop being true.
    "POSTAL_ADDRESS": "LoanHank · 109b - 1917 Peninsula Rd, Ucluelet, BC V0R 3A0, Canada",
    // Meta ads measurement (spec.md section 10). The dataset id is public by
    // design: it is readable in the source of any site that runs a pixel, and
    // ours never runs one. Same reasoning as POSTAL_ADDRESS above, so it lives
    // in git rather than in a store nobody reads. It was briefly added through
    // the Cloudflare dashboard instead, on 2026-08-18, which creates a version
    // nobody deploys and a plaintext variable the next deploy silently drops.
    // Measurement would have stopped without saying so.
    //
    // META_CAPI_TOKEN is the secret and it is the switch. The sender needs both
    // values, so measurement stays off until the token is set with
    // `wrangler secret put`. One thing to flip, and it is the one that is
    // genuinely a secret.
    "META_DATASET_ID": "1770792024264156"
  }
}
