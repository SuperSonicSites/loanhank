# Copy to .dev.vars for local `pnpm dev`. In production every one of these is a
# Worker secret set with `wrangler secret put NAME`. Never commit real values.
#
# NOT in this file: CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID are CI-side
# secrets (GitHub Actions), never Worker secrets. D1/R2 bindings live in
# wrangler.jsonc, not env.

# Vision extraction provider (spec.md Decision 5). Set a hard monthly spend cap
# on the provider account itself, not only in code.
OPENAI_API_KEY=
# Optional override of the extraction model id; default lives in src/api/extractor.ts.
EXTRACTION_MODEL=

# Cloudflare Turnstile, invisible mode on submit (spec.md Decision 7).
# Prefilled with Cloudflare's documented always-pass TEST keypair so local dev
# works out of the box. Real keys: dashboard → Turnstile. The real site key is
# public and ships in wrangler.jsonc vars; only the secret key is a secret.
# Full dummy-key set (always-fail, token-spent): Cloudflare Turnstile testing docs.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Transactional email for the teardown PDF (spec.md Decisions 6 and 10).
# Sender domain is mail.loanhank.com; SPF/DKIM/DMARC must be live before real sends.
RESEND_API_KEY=
EMAIL_FROM=hank@mail.loanhank.com

# Meta Conversions API, server-side only, no pixel (spec.md Decision 8).
# PIXEL_ID is what Meta now calls the dataset id.
META_CAPI_ACCESS_TOKEN=
META_PIXEL_ID=

# Salt for hashing IPs in the per-extract rate limiter. Any long random string.
RATE_LIMIT_SALT=
